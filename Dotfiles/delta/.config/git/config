# Réglages globaux de présentation seulement : aucune identité ni authentification.
# Git lit aussi ~/.gitconfig, dont les valeurs peuvent surcharger celles-ci.
# Déployer ce paquet seulement si git-delta est installé.
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    syntax-theme = TwoDark
